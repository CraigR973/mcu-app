# App
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Database (async SQLAlchemy / asyncpg)
# Hosted postgresql:// and postgres:// URLs are normalised to this driver at boot.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mcu_app

# JWT authentication (used from Batch 3; min 32 random characters outside development)
JWT_ACCESS_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-secret-at-least-32-chars

# TMDB (used by the Batch 4 import pipeline)
TMDB_API_KEY=your-tmdb-api-key
TMDB_READ_TOKEN=your-tmdb-read-token

# Sentry (optional)
SENTRY_DSN_BACKEND=
