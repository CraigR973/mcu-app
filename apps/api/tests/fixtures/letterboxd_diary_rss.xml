<?xml version="1.0" encoding="UTF-8"?>
<!--
  Batch S5's feed fixture.

  CONSTRUCTED FROM A MEASUREMENT, NOT CAPTURED FROM THE WIRE. The element names and the
  guid format below are what `OWNER-ACTIONS.md` 1f recorded from both real feeds on
  2026-09-14 across 100 entries. The exact namespace URIs and the surrounding structure
  were not captured, because doing so needs a live third-party request and
  `docs/agent-commands/group-start.md` keeps those out of unattended runs.

  The parser therefore matches on LOCAL NAMES and ignores prefixes entirely, and falls
  back to RSS's own <title> when the namespaced title is absent — so a namespace URI that
  differs from the guess below changes nothing. `OWNER-ACTIONS.md` 1j is the owner check
  that settles it.
-->
<rss version="2.0"
     xmlns:letterboxd="https://letterboxd.com"
     xmlns:tmdb="https://themoviedb.org">
  <channel>
    <title>Craig’s film diary</title>
    <link>https://letterboxd.com/CraigR973/</link>

    <!-- A rated, first watch. Craig rates 50 of 50. -->
    <item>
      <title>Pressure, 2026 - ★★★★</title>
      <link>https://letterboxd.com/CraigR973/film/pressure-2026/</link>
      <guid>letterboxd-watch-900000001</guid>
      <pubDate>Wed, 10 Sep 2026 08:00:00 +0000</pubDate>
      <letterboxd:filmTitle>Pressure</letterboxd:filmTitle>
      <letterboxd:filmYear>2026</letterboxd:filmYear>
      <letterboxd:watchedDate>2026-09-09</letterboxd:watchedDate>
      <letterboxd:rewatch>No</letterboxd:rewatch>
      <letterboxd:memberRating>4.0</letterboxd:memberRating>
      <tmdb:movieId>111111</tmdb:movieId>
    </item>

    <!-- A rewatch, and the watched date differs from pubDate on purpose. -->
    <item>
      <title>Get Out, 2017 - ★★★★</title>
      <guid>letterboxd-watch-900000002</guid>
      <pubDate>Sat, 06 Sep 2026 09:30:00 +0000</pubDate>
      <letterboxd:filmTitle>Get Out</letterboxd:filmTitle>
      <letterboxd:filmYear>2017</letterboxd:filmYear>
      <letterboxd:watchedDate>2026-09-05</letterboxd:watchedDate>
      <letterboxd:rewatch>Yes</letterboxd:rewatch>
      <letterboxd:memberRating>4.0</letterboxd:memberRating>
      <tmdb:movieId>419430</tmdb:movieId>
    </item>

    <!-- No memberRating at all. Mark's entries look like this: 0 of 50 carry one. -->
    <item>
      <title>The Collector, 1965</title>
      <guid>letterboxd-watch-900000003</guid>
      <pubDate>Mon, 30 Mar 2026 21:00:00 +0000</pubDate>
      <letterboxd:filmTitle>The Collector</letterboxd:filmTitle>
      <letterboxd:filmYear>1965</letterboxd:filmYear>
      <letterboxd:watchedDate>2026-03-28</letterboxd:watchedDate>
      <letterboxd:rewatch>No</letterboxd:rewatch>
      <tmdb:movieId>29259</tmdb:movieId>
    </item>

    <!-- No namespaced title: the parser falls back to "<title>Name, Year". -->
    <item>
      <title>Fast &amp; Furious, 2009</title>
      <guid>letterboxd-watch-900000004</guid>
      <pubDate>Sun, 15 Feb 2026 20:00:00 +0000</pubDate>
      <letterboxd:watchedDate>2026-02-14</letterboxd:watchedDate>
      <letterboxd:rewatch>No</letterboxd:rewatch>
    </item>

    <!-- Not a viewing. Letterboxd puts list publications in the same channel; this has no
         letterboxd-watch- guid and must be skipped rather than treated as a parse error. -->
    <item>
      <title>Craig’s list: Best of 2026</title>
      <guid>letterboxd-list-55555</guid>
      <pubDate>Tue, 01 Sep 2026 12:00:00 +0000</pubDate>
    </item>
  </channel>
</rss>
