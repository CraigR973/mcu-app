{
  "permissions": {
    "allow": [
      "Bash(apps/api/.venv/bin/ruff check *)",
      "Bash(apps/api/.venv/bin/ruff format --check *)",
      "Bash(PYTHONPATH=apps/api apps/api/.venv/bin/mypy *)",
      "Bash(git -C /Users/craigrobinson/mcu_app status --porcelain)",
      "Bash(git -C /Users/craigrobinson/mcu_app diff *)",
      "Bash(git -C /Users/craigrobinson/mcu_app log *)",
      "Bash(git fetch *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"$CLAUDE_PROJECT_DIR\"; B=$(git -C \"$R\" rev-parse --abbrev-ref HEAD 2>/dev/null) && [ \"$B\" != \"main\" ] && [ -z \"$(git -C \"$R\" status --porcelain)\" ] && [ -z \"$(git -C \"$R\" log @{u}.. 2>/dev/null)\" ] && echo 'Branch clean and pushed - close out once the gate is green (DECISIONS.md #24)' || true"
          }
        ]
      }
    ]
  }
}
